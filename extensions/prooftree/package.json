{
  "name": "prooftree",
  "displayName": "Prooftree",
  "description": "Claims, evidence and reviews for code written by agents and people.",
  "version": "0.1.0",
  "publisher": "prooftree",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Checks run commands from the workspace's .prooftree/config.json."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prooftree",
          "title": "Prooftree",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "prooftree": [
        {
          "id": "prooftree.claims",
          "name": "Claims",
          "icon": "$(shield)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "prooftree.claims",
        "contents": "Claims state what is true about the code, anchored to the lines that make it true. Break a goal into steps; evidence goes stale when those lines, a premise or a check change.\n[Declare Claim from Selection](command:prooftree.declareClaim)\n[Configure Checks](command:prooftree.openConfig)\n[Connect Agents](command:prooftree.installAgentHooks)\n[Add CI Workflow](command:prooftree.addCiWorkflow)",
        "when": "!prooftree.hasClaims"
      }
    ],
    "commands": [
      {
        "command": "prooftree.declareClaim",
        "title": "Declare Claim from Selection",
        "category": "Prooftree",
        "icon": "$(add)"
      },
      {
        "command": "prooftree.runCheck",
        "title": "Run Check",
        "category": "Prooftree",
        "icon": "$(play)"
      },
      {
        "command": "prooftree.approve",
        "title": "Approve",
        "category": "Prooftree",
        "icon": "$(verified)"
      },
      {
        "command": "prooftree.reject",
        "title": "Reject",
        "category": "Prooftree",
        "icon": "$(thumbsdown)"
      },
      {
        "command": "prooftree.reanchor",
        "title": "Re-anchor at Current Code",
        "category": "Prooftree",
        "icon": "$(pin)"
      },
      {
        "command": "prooftree.retract",
        "title": "Retract",
        "category": "Prooftree",
        "icon": "$(trash)"
      },
      {
        "command": "prooftree.revealClaim",
        "title": "Show Claim",
        "category": "Prooftree"
      },
      {
        "command": "prooftree.openConfig",
        "title": "Open Config",
        "category": "Prooftree",
        "icon": "$(gear)"
      },
      {
        "command": "prooftree.openLedger",
        "title": "Open Ledger",
        "category": "Prooftree",
        "icon": "$(book)"
      },
      {
        "command": "prooftree.installAgentHooks",
        "title": "Connect Agents (Hooks and MCP)",
        "category": "Prooftree",
        "icon": "$(plug)"
      },
      {
        "command": "prooftree.refresh",
        "title": "Refresh",
        "category": "Prooftree",
        "icon": "$(refresh)"
      },
      {
        "category": "Prooftree",
        "command": "prooftree.addStep",
        "title": "Add Step to Goal",
        "icon": "$(list-ordered)"
      },
      {
        "category": "Prooftree",
        "command": "prooftree.linkLean",
        "title": "Link Lean Declaration",
        "icon": "$(symbol-function)"
      },
      {
        "category": "Prooftree",
        "command": "prooftree.showGraph",
        "title": "Show Knowledge Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "category": "Prooftree",
        "command": "prooftree.setReasoningDepth",
        "title": "Set Reasoning Depth",
        "icon": "$(list-tree)"
      },
      {
        "category": "Prooftree",
        "command": "prooftree.addCiWorkflow",
        "title": "Add CI Workflow",
        "icon": "$(github-action)"
      },
      {
        "category": "Prooftree",
        "command": "prooftree.reviewEdit",
        "title": "Mark Agent Edit Reviewed",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "prooftree.revealClaim",
          "when": "false"
        },
        {
          "command": "prooftree.reviewEdit",
          "when": "prooftree.enabled"
        }
      ],
      "view/title": [
        {
          "command": "prooftree.declareClaim",
          "when": "view == prooftree.claims",
          "group": "navigation@1"
        },
        {
          "command": "prooftree.refresh",
          "when": "view == prooftree.claims",
          "group": "navigation@2"
        },
        {
          "command": "prooftree.openConfig",
          "when": "view == prooftree.claims",
          "group": "1_config@1"
        },
        {
          "command": "prooftree.openLedger",
          "when": "view == prooftree.claims",
          "group": "1_config@2"
        },
        {
          "command": "prooftree.installAgentHooks",
          "when": "view == prooftree.claims",
          "group": "1_config@3"
        },
        {
          "command": "prooftree.showGraph",
          "when": "view == prooftree.claims",
          "group": "navigation@3"
        },
        {
          "command": "prooftree.setReasoningDepth",
          "when": "view == prooftree.claims",
          "group": "navigation@4"
        },
        {
          "command": "prooftree.addCiWorkflow",
          "when": "view == prooftree.claims",
          "group": "1_config@4"
        }
      ],
      "view/item/context": [
        {
          "command": "prooftree.runCheck",
          "when": "view == prooftree.claims && viewItem == prooftree.claim",
          "group": "inline@1"
        },
        {
          "command": "prooftree.approve",
          "when": "view == prooftree.claims && viewItem == prooftree.claim",
          "group": "inline@2"
        },
        {
          "command": "prooftree.reanchor",
          "when": "view == prooftree.claims && viewItem == prooftree.claim",
          "group": "1_claim@1"
        },
        {
          "command": "prooftree.reject",
          "when": "view == prooftree.claims && viewItem == prooftree.claim",
          "group": "1_claim@2"
        },
        {
          "command": "prooftree.retract",
          "when": "view == prooftree.claims && viewItem == prooftree.claim",
          "group": "2_danger@1"
        },
        {
          "command": "prooftree.addStep",
          "when": "view == prooftree.claims && viewItem == prooftree.claim",
          "group": "0_structure@1"
        },
        {
          "command": "prooftree.linkLean",
          "when": "view == prooftree.claims && viewItem == prooftree.claim",
          "group": "0_structure@2"
        },
        {
          "command": "prooftree.reviewEdit",
          "when": "view == prooftree.claims && viewItem == prooftree.edit",
          "group": "inline@1"
        },
        {
          "command": "prooftree.declareClaim",
          "when": "view == prooftree.claims && viewItem == prooftree.edit",
          "group": "inline@2"
        }
      ],
      "editor/context": [
        {
          "command": "prooftree.declareClaim",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "prooftree@1"
        },
        {
          "command": "prooftree.reviewEdit",
          "when": "prooftree.enabled && resourceScheme == file",
          "group": "prooftree@2"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": ".prooftree/config.json",
        "url": "./schemas/config.schema.json"
      }
    ],
    "languageModelTools": [
      {
        "name": "prooftree_declare_claim",
        "toolReferenceName": "declareClaim",
        "displayName": "Declare Claim",
        "icon": "$(shield)",
        "canBeReferencedInPrompt": true,
        "userDescription": "Declare Claim in the Prooftree ledger",
        "modelDescription": "Declare a claim: one specific statement that is now true about the code (behavior, invariant or requirement), anchored to the lines that make it true. Give `parent` to add it as a step of an existing goal. Returns the claim id and status. Then discharge it with prooftree_run_check.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "statement": {
              "type": "string",
              "description": "A checkable statement, e.g. \"parseDate rejects months above 12\"."
            },
            "anchors": {
              "type": "array",
              "description": "Where the claim is made true. Line numbers are 1-based and inclusive; omit them to anchor the whole file. A goal stated only through its steps may omit anchors.",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "description": "Workspace-relative or absolute path."
                  },
                  "startLine": {
                    "type": "number"
                  },
                  "endLine": {
                    "type": "number"
                  }
                },
                "required": [
                  "file"
                ]
              }
            },
            "dependsOn": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Ids of existing claims this claim relies on (premises). Their changes make this claim's evidence stale."
            },
            "reasoning": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 3,
              "description": "Why the claim holds, from shortest to most detailed: a one-line summary, then an explanation, then full detail. Readers choose how deep to read."
            },
            "formal": {
              "type": "object",
              "description": "A Lean declaration that states this claim formally, checked by a \"lean\" check. It fails if the proof uses sorry.",
              "properties": {
                "file": {
                  "type": "string",
                  "description": "Path of the .lean file."
                },
                "declaration": {
                  "type": "string",
                  "description": "Name of the theorem or lemma."
                }
              },
              "required": [
                "file",
                "declaration"
              ]
            },
            "parent": {
              "type": "string",
              "description": "Id of the goal this claim is a step of."
            }
          },
          "required": [
            "statement"
          ]
        }
      },
      {
        "name": "prooftree_decompose",
        "toolReferenceName": "decompose",
        "displayName": "Decompose Goal",
        "icon": "$(shield)",
        "canBeReferencedInPrompt": true,
        "userDescription": "Decompose Goal in the Prooftree ledger",
        "modelDescription": "State a goal and break it into ordered steps in one call, like a proof outline. The goal is proved when every step is discharged; each step is a normal claim with its own anchors and checks. Use this to plan a change before making it.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "statement": {
              "type": "string",
              "description": "A checkable statement, e.g. \"parseDate rejects months above 12\"."
            },
            "anchors": {
              "type": "array",
              "description": "Where the claim is made true. Line numbers are 1-based and inclusive; omit them to anchor the whole file. A goal stated only through its steps may omit anchors.",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "description": "Workspace-relative or absolute path."
                  },
                  "startLine": {
                    "type": "number"
                  },
                  "endLine": {
                    "type": "number"
                  }
                },
                "required": [
                  "file"
                ]
              }
            },
            "dependsOn": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Ids of existing claims this claim relies on (premises). Their changes make this claim's evidence stale."
            },
            "reasoning": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 3,
              "description": "Why the claim holds, from shortest to most detailed: a one-line summary, then an explanation, then full detail. Readers choose how deep to read."
            },
            "formal": {
              "type": "object",
              "description": "A Lean declaration that states this claim formally, checked by a \"lean\" check. It fails if the proof uses sorry.",
              "properties": {
                "file": {
                  "type": "string",
                  "description": "Path of the .lean file."
                },
                "declaration": {
                  "type": "string",
                  "description": "Name of the theorem or lemma."
                }
              },
              "required": [
                "file",
                "declaration"
              ]
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "description": "The steps, in order. Each is a claim.",
              "items": {
                "type": "object",
                "properties": {
                  "statement": {
                    "type": "string",
                    "description": "A checkable statement, e.g. \"parseDate rejects months above 12\"."
                  },
                  "anchors": {
                    "type": "array",
                    "description": "Where the claim is made true. Line numbers are 1-based and inclusive; omit them to anchor the whole file. A goal stated only through its steps may omit anchors.",
                    "items": {
                      "type": "object",
                      "properties": {
                        "file": {
                          "type": "string",
                          "description": "Workspace-relative or absolute path."
                        },
                        "startLine": {
                          "type": "number"
                        },
                        "endLine": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "file"
                      ]
                    }
                  },
                  "dependsOn": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Ids of existing claims this claim relies on (premises). Their changes make this claim's evidence stale."
                  },
                  "reasoning": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 3,
                    "description": "Why the claim holds, from shortest to most detailed: a one-line summary, then an explanation, then full detail. Readers choose how deep to read."
                  },
                  "formal": {
                    "type": "object",
                    "description": "A Lean declaration that states this claim formally, checked by a \"lean\" check. It fails if the proof uses sorry.",
                    "properties": {
                      "file": {
                        "type": "string",
                        "description": "Path of the .lean file."
                      },
                      "declaration": {
                        "type": "string",
                        "description": "Name of the theorem or lemma."
                      }
                    },
                    "required": [
                      "file",
                      "declaration"
                    ]
                  }
                },
                "required": [
                  "statement"
                ]
              }
            }
          },
          "required": [
            "statement",
            "steps"
          ]
        }
      },
      {
        "name": "prooftree_update_claim",
        "toolReferenceName": "updateClaim",
        "displayName": "Update Claim",
        "icon": "$(shield)",
        "canBeReferencedInPrompt": true,
        "userDescription": "Update Claim in the Prooftree ledger",
        "modelDescription": "Write a new revision of a claim after its code changed or its statement, reasoning or Lean link needs correcting. Without anchors, re-anchors to the current text at the existing locations. Earlier evidence does not carry over; run a check afterwards.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "claim": {
              "type": "string",
              "description": "Claim id."
            },
            "statement": {
              "type": "string",
              "description": "A checkable statement, e.g. \"parseDate rejects months above 12\"."
            },
            "anchors": {
              "type": "array",
              "description": "Where the claim is made true. Line numbers are 1-based and inclusive; omit them to anchor the whole file. A goal stated only through its steps may omit anchors.",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "description": "Workspace-relative or absolute path."
                  },
                  "startLine": {
                    "type": "number"
                  },
                  "endLine": {
                    "type": "number"
                  }
                },
                "required": [
                  "file"
                ]
              }
            },
            "dependsOn": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Ids of existing claims this claim relies on (premises). Their changes make this claim's evidence stale."
            },
            "reasoning": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 3,
              "description": "Why the claim holds, from shortest to most detailed: a one-line summary, then an explanation, then full detail. Readers choose how deep to read."
            },
            "formal": {
              "type": "object",
              "description": "A Lean declaration that states this claim formally, checked by a \"lean\" check. It fails if the proof uses sorry.",
              "properties": {
                "file": {
                  "type": "string",
                  "description": "Path of the .lean file."
                },
                "declaration": {
                  "type": "string",
                  "description": "Name of the theorem or lemma."
                }
              },
              "required": [
                "file",
                "declaration"
              ]
            }
          },
          "required": [
            "claim"
          ]
        }
      },
      {
        "name": "prooftree_run_check",
        "toolReferenceName": "runCheck",
        "displayName": "Run Check",
        "icon": "$(shield)",
        "canBeReferencedInPrompt": true,
        "userDescription": "Run Check in the Prooftree ledger",
        "modelDescription": "Run one of the workspace's configured checks (from .prooftree/config.json) and record the result as evidence for a claim, bound to the current code and the check's inputs. A \"lean\" check compiles the claim's Lean declaration. Only a passing check discharges a claim.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "claim": {
              "type": "string",
              "description": "Claim id."
            },
            "check": {
              "type": "string",
              "description": "Name of a configured check."
            }
          },
          "required": [
            "claim",
            "check"
          ]
        }
      },
      {
        "name": "prooftree_assert",
        "toolReferenceName": "assert",
        "displayName": "Assert Claim",
        "icon": "$(shield)",
        "canBeReferencedInPrompt": true,
        "userDescription": "Assert Claim in the Prooftree ledger",
        "modelDescription": "Record your reasoning that a claim holds without a machine check. Shown to reviewers as \"asserted only\"; it does not discharge the claim unless the workspace accepts assertions.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "claim": {
              "type": "string",
              "description": "Claim id."
            },
            "note": {
              "type": "string",
              "description": "Why the claim holds."
            }
          },
          "required": [
            "claim",
            "note"
          ]
        }
      },
      {
        "name": "prooftree_list_obligations",
        "toolReferenceName": "listObligations",
        "displayName": "List Obligations",
        "icon": "$(shield)",
        "canBeReferencedInPrompt": true,
        "userDescription": "List Obligations in the Prooftree ledger",
        "modelDescription": "List claims that are not yet discharged (stale, failed, changed, blocked or without a check), each with the next step and the configured checks.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "prooftree_status",
        "toolReferenceName": "status",
        "displayName": "Claim Status",
        "icon": "$(shield)",
        "canBeReferencedInPrompt": true,
        "userDescription": "Claim Status in the Prooftree ledger",
        "modelDescription": "Show every open claim, or one claim, with its reasoning, steps, anchors, premises, Lean link, machine result and human review.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "claim": {
              "type": "string",
              "description": "Optional claim id."
            },
            "depth": {
              "type": "number",
              "minimum": 1,
              "maximum": 3,
              "description": "Reasoning depth to show: 1 summary, 2 explanation, 3 full detail."
            }
          }
        }
      },
      {
        "name": "prooftree_outline",
        "toolReferenceName": "outline",
        "displayName": "Proof Outline",
        "icon": "$(shield)",
        "canBeReferencedInPrompt": true,
        "userDescription": "Proof Outline in the Prooftree ledger",
        "modelDescription": "Show goals and their numbered steps as an outline with statuses, with reasoning at the chosen depth.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "depth": {
              "type": "number",
              "minimum": 1,
              "maximum": 3,
              "description": "Reasoning depth to show: 1 summary, 2 explanation, 3 full detail."
            }
          }
        }
      },
      {
        "name": "prooftree_graph",
        "toolReferenceName": "graph",
        "displayName": "Knowledge Graph",
        "icon": "$(shield)",
        "canBeReferencedInPrompt": true,
        "userDescription": "Knowledge Graph in the Prooftree ledger",
        "modelDescription": "Query the knowledge graph of claims, steps, premises, files, Lean declarations and checks. Give `focus` (a claim id, file path, Lean declaration or check name) to see what is connected to it, for example which claims cover a file you are about to edit.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "focus": {
              "type": "string",
              "description": "Claim id, workspace-relative file path, Lean declaration or check name."
            },
            "radius": {
              "type": "number",
              "minimum": 1,
              "maximum": 4,
              "description": "How many edges away to include (default 2)."
            }
          }
        }
      }
    ],
    "configuration": {
      "title": "Prooftree",
      "properties": {
        "prooftree.reasoningDepth": {
          "type": "number",
          "enum": [
            1,
            2,
            3
          ],
          "default": 1,
          "enumDescriptions": [
            "Summary",
            "Explanation",
            "Full detail"
          ],
          "description": "How much of each claim's reasoning to show in the claims view and hovers. Deeper levels show more explanation, not more certainty. Hovers also have + and - buttons."
        }
      }
    },
    "colors": [
      {
        "id": "prooftree.unverifiedAgentCodeBackground",
        "description": "Background of agent-written lines that no person reviewed and no checked or approved claim covers.",
        "defaults": {
          "dark": "#a371f714",
          "light": "#8250df0f",
          "highContrast": "#d2a8ff1f",
          "highContrastLight": "#6639ba1a"
        }
      },
      {
        "id": "prooftree.unverifiedAgentCodeOverviewRuler",
        "description": "Overview ruler mark and icon color for agent-written lines without a review or passing check.",
        "defaults": {
          "dark": "#a371f7",
          "light": "#8250df",
          "highContrast": "#d2a8ff",
          "highContrastLight": "#6639ba"
        }
      }
    ]
  },
  "scripts": {
    "compile": "gulp compile-extension:prooftree",
    "watch": "gulp watch-extension:prooftree",
    "test": "node --test \"out/test/**/*.test.js\"",
    "build-cli": "node build-cli.mjs"
  },
  "enabledApiProposals": [
    "editorHoverVerbosityLevel"
  ]
}
